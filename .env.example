# AI Document Assistant Environment Configuration

# Environment
ENV=development
PROJECT_NAME="AI Document Assistant"

# Database Configuration (PostgreSQL + pgvector or auto-fallback to SQLite)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/docassistant
SQLITE_URL=sqlite+aiosqlite:///./docassistant.db
USE_SQLITE_FALLBACK=True

# Document Processing & Tesseract OCR
TESSERACT_CMD=tesseract
OCR_CHAR_THRESHOLD=40
OCR_DPI=200

# Chunking & Embeddings
CHUNK_SIZE=500
CHUNK_OVERLAP=100
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384

# Vector Search & RAG
TOP_K_CHUNKS=5
SIMILARITY_THRESHOLD=0.25

# Optional LLM API Keys (Automatic fallback synthesis if unprovided)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

GROQ_API_KEY=
GROQ_MODEL=llama-3.1-70b-versatile

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
